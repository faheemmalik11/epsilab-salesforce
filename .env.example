# Host ports published by docker compose (GUI and REST/MCP).
GUI_PORT=3000
API_PORT=8080
SEED_PROFILE=default
# Fixed app clock. The seed README suggests 2028-11-11.
CLOCK=2028-11-11T09:00:00Z
# "offset" starts at CLOCK and advances with real time; "fixed" always returns CLOCK.
CLOCK_MODE=offset
# User the API acts as when a request names none (X-User-Id header or MCP actingUserId).
# Empty means the first active user by name.
DEFAULT_USER_ID=
# Host names accepted by the /mcp endpoint (DNS rebinding protection).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
