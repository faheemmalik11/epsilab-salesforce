# Host ports published by docker compose (GUI and REST/MCP).
GUI_PORT=3000
API_PORT=8080
SEED_PROFILE=default
# Fixed app clock. The seed README suggests 2028-11-11.
CLOCK=2028-11-11T09:00:00Z
# Host names accepted by the /mcp endpoint (DNS rebinding protection).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
